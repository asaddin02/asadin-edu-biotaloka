{
  "name": "asadin-edu-biotaloka",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.mjs",
    "dev": "PORT=8085 HOST=127.0.0.1 LOG=1 node server/server.mjs",
    "start:static": "python3 -m http.server 8085 --bind 127.0.0.1",
    "build": "node scripts/build-sw.mjs",
    "build:site": "node scripts/build-sw.mjs && node scripts/build-site.mjs",
    "snapshot": "node scripts/build-snapshot.mjs",
    "preview:cloudflare": "npm run build:site && npx --yes wrangler@4 pages dev dist --port 8788 --compatibility-date=2026-09-21",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "playwright test",
    "smoke": "node tests/live-smoke.mjs",
    "data:check": "node scripts/check-data.mjs",
    "check": "npm run lint && npm run data:check && npm run build:check && npm test",
    "build:check": "node scripts/build-sw.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "leaflet": "^1.9.4",
    "prettier": "^3.9.9"
  },
  "description": "Biotaloka · Asadin Edu — open, bilingual atlas of life for primary school to university learners and teachers.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asaddin02/asadin-edu-biotaloka.git"
  },
  "bugs": {
    "url": "https://github.com/asaddin02/asadin-edu-biotaloka/issues"
  },
  "homepage": "https://github.com/asaddin02/asadin-edu-biotaloka#readme"
}
